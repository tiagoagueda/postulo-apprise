#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s a(z) %(host)s címen: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Egy kapcsolat legfeljebb %(count)d Apprise URL-t tartalmazhat."
msgstr[1] "Egy kapcsolat legfeljebb %(count)d Apprise URL-t tartalmazhat."

#: src/postulo_apprise/services.py
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr "Azon a gépen működik, amelyen a Postulo fut, nem pedig valamelyik szolgáltatásán, ezért nem használható."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise URL-ek"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Legalább egy Apprise URL szükséges."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Legalább egy szolgáltatás elutasította az üzenetet."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Kézbesítve %(count)d szolgáltatásnak."
msgstr[1] "Kézbesítve %(count)d szolgáltatásnak."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "A(z) %(line)d. sor (%(scheme)s) azon a gépen végez műveletet, amelyen a Postulo fut, nem az Ön valamelyik szolgáltatásán, ezért itt nem használható."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "A(z) %(line)d. sor az átirányítások követését kéri; a Postulo soha nem követ átirányítást, ezért adja meg a végső címet."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "A(z) %(line)d. sor nem olyan Apprise URL, amelyet ez a verzió ért (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "A(z) %(line)d. sor egy fájlt nevez meg azon a gépen, amelyen a Postulo fut (%(argument)s=). Adjon meg helyette egy https-címet."

#: src/postulo_apprise/services.py
msgid "Needs {packages}, which is not installed on this machine."
msgstr "Szükséges hozzá: {packages}, amely nincs telepítve ezen a gépen."

#: src/postulo_apprise/services.py
msgid "Not available on this machine."
msgstr "Ezen a gépen nem érhető el."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Soronként egy, az Apprise formátumában: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, vagy bármely más, az Apprise által felsorolt szolgáltatás. A hitelesítő adatok az URL-ben vannak, ezért az egész mező titkosítva tárolódik, és többé nem jelenik meg; a kapcsolatok listája csak az egyes szolgáltatások nevét mutatja, saját kiszolgálón futó szolgáltatásnál pedig azt a kiszolgálót is."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "A Postulo itt érheti el Önt"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "A Postulo értesítéseinek továbbítása az Apprise segítségével a Telegram, az ntfy, a Discord, a Matrix, a Gotify, a Pushover, a Signal, az e-mail és jóval több mint száz további szolgáltatás felé. Mindegyiket egyetlen cím adja meg, amely a hozzáférési adatait is tartalmazza, és titkosítva tárolódik."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr "Ezen a példányon kikapcsolva: %(services)s. Egy adminisztrátor bekapcsolhatja."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "A szolgáltatások nem válaszoltak %(seconds)d másodpercen belül."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Külső értesítések az Apprise-on keresztül"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Ez az Apprise-kapcsolata tesztüzenete. Az emlékeztetők és a rögzítések ugyanígy érkeznek majd."
