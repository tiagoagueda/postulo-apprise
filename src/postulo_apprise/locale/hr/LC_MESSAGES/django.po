#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s na %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Veza sadrži najviše %(count)d Apprise URL."
msgstr[1] "Veza sadrži najviše %(count)d Apprise URL-a."
msgstr[2] "Veza sadrži najviše %(count)d Apprise URL-ova."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Apprise URL-ovi"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "Potreban je barem jedan Apprise URL."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Barem jedna usluga odbila je poruku."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Isporučeno na %(count)d uslugu."
msgstr[1] "Isporučeno na %(count)d usluge."
msgstr[2] "Isporučeno na %(count)d usluga."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Redak %(line)d (%(scheme)s) djeluje na računalu na kojem radi Postulo, a ne na nekoj vašoj usluzi, pa se ovdje ne može koristiti."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Redak %(line)d traži da se slijede preusmjeravanja; Postulo ih nikad ne slijedi, pa navedite konačnu adresu."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Redak %(line)d nije Apprise URL koji ova verzija razumije (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Redak %(line)d navodi datoteku na računalu na kojem radi Postulo (%(argument)s=). Umjesto toga navedite https adresu."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Jedan po retku, u obliku koji koristi Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org i bilo koji drugi koje Apprise navodi. Vjerodajnice su unutar URL-a, pa se cijelo polje pohranjuje šifrirano i nikad se više ne prikazuje; popis veza prikazuje samo naziv svake usluge i, za uslugu na vašem vlastitom poslužitelju, taj poslužitelj."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo vas ovdje može doseći"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Usluge nisu odgovorile unutar %(seconds)d sekundi."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Ovo je testna poruka iz vaše Apprise veze. Podsjetnici i hvatanja stizat će na isti način."
