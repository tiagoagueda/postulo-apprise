#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s na %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Připojení může obsahovat nejvýše %(count)d adresu URL Apprise."
msgstr[1] "Připojení může obsahovat nejvýše %(count)d adresy URL Apprise."
msgstr[2] "Připojení může obsahovat nejvýše %(count)d adres URL Apprise."

#: src/postulo_apprise/services.py
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr ""

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Adresy URL Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Je potřeba alespoň jedna adresa URL Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Alespoň jedna služba zprávu odmítla."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Doručeno %(count)d službě."
msgstr[1] "Doručeno %(count)d službám."
msgstr[2] "Doručeno %(count)d službám."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Řádek %(line)d (%(scheme)s) působí na počítač, na kterém Postulo běží, ne na některou z vašich služeb, takže ho zde nelze použít."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Řádek %(line)d požaduje sledování přesměrování; Postulo přesměrování nikdy nesleduje, uveďte proto konečnou adresu."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Řádek %(line)d není adresa URL Apprise, které by tato verze rozuměla (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Řádek %(line)d odkazuje na soubor na počítači, na kterém Postulo běží (%(argument)s=). Uveďte místo toho adresu https."

#: src/postulo_apprise/services.py
msgid "Needs {packages}, which is not installed on this machine."
msgstr ""

#: src/postulo_apprise/services.py
msgid "Not available on this machine."
msgstr ""

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Jedna na řádek, ve tvaru Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org a kterékoli další, které Apprise uvádí. Přihlašovací údaje jsou přímo v adrese URL, proto se celé pole ukládá zašifrovaně a už se nikdy nezobrazí; seznam připojení ukazuje jen název každé služby a u služby na vašem vlastním serveru i tento server."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo vás zde může zastihnout"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Posílá oznámení Postulo přes Apprise do Telegramu, ntfy, Discordu, Matrixu, Gotify, Pushoveru, Signalu, e-mailu a více než stovky dalších služeb. Každá služba je určena jednou adresou, která obsahuje její přihlašovací údaje a ukládá se zašifrovaně."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr ""

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Služby neodpověděly do %(seconds)d sekund."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Oznámení třetích stran přes Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Toto je testovací zpráva z vašeho připojení Apprise. Připomenutí a zachycení budou přicházet stejnou cestou."
