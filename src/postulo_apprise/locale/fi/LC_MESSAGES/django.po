#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s osoitteessa %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Yhteydessä voi olla enintään %(count)d Apprise-URL."
msgstr[1] "Yhteydessä voi olla enintään %(count)d Apprise-URL:ää."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise-URL-osoitteet"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Tarvitaan vähintään yksi Apprise-URL."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Vähintään yksi palvelu hylkäsi viestin."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Toimitettu %(count)d palveluun."
msgstr[1] "Toimitettu %(count)d palveluun."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Rivi %(line)d (%(scheme)s) vaikuttaa koneeseen, jolla Postulo toimii, eikä omaan palveluusi, joten sitä ei voi käyttää tässä."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Rivi %(line)d pyytää seuraamaan uudelleenohjauksia; Postulo ei koskaan seuraa niitä, joten anna lopullinen osoite."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Rivi %(line)d ei ole Apprise-URL, jonka tämä versio ymmärtää (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Rivi %(line)d viittaa tiedostoon koneella, jolla Postulo toimii (%(argument)s=). Anna sen sijaan https-osoite."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Yksi riville, Apprisen muodossa: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org ja mikä tahansa muu Apprisen luettelemista. Tunnistetiedot ovat URL-osoitteen sisällä, joten koko kenttä tallennetaan salattuna eikä sitä näytetä enää koskaan; yhteysluettelossa näkyy vain kunkin palvelun nimi ja omalla palvelimellasi olevan palvelun kohdalla myös kyseinen palvelin."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo tavoittaa sinut täältä"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Lähetä Postulon ilmoitukset Apprisen kautta Telegramiin, ntfy:hin, Discordiin, Matrixiin, Gotifyhin, Pushoveriin, Signaliin, sähköpostiin ja yli sataan muuhun palveluun. Kukin määritetään yhdellä osoitteella, joka sisältää sen tunnistetiedot ja tallennetaan salattuna."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Palvelut eivät vastanneet %(seconds)d sekunnin kuluessa."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Kolmansien osapuolten ilmoitukset Apprisen kautta"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Tämä on Apprise-yhteytesi testiviesti. Muistutukset ja kaappaukset saapuvat samalla tavalla."
