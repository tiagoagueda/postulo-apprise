#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s на %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Връзката съдържа най-много %(count)d Apprise URL адрес."
msgstr[1] "Връзката съдържа най-много %(count)d Apprise URL адреса."

#: src/postulo_apprise/services.py
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr "Действа върху машината, на която работи Postulo, а не върху ваша услуга, затова не може да се използва."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise URL адреси"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Нужен е поне един Apprise URL адрес."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Поне една услуга отказа съобщението."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Доставено до %(count)d услуга."
msgstr[1] "Доставено до %(count)d услуги."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Ред %(line)d (%(scheme)s) действа върху машината, на която работи Postulo, а не върху ваша услуга, затова не може да се използва тук."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Ред %(line)d изисква следване на пренасочвания; Postulo никога не следва пренасочвания, затова дайте крайния адрес."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Ред %(line)d не е Apprise URL адрес, който тази версия разбира (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Ред %(line)d посочва файл на машината, на която работи Postulo (%(argument)s=). Вместо това дайте https адрес."

#: src/postulo_apprise/services.py
msgid "Needs {packages}, which is not installed on this machine."
msgstr "Изисква {packages}, което не е инсталирано на тази машина."

#: src/postulo_apprise/services.py
msgid "Not available on this machine."
msgstr "Не е налично на тази машина."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "По един на ред, във формата на Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org и всички останали, които Apprise изброява. Данните за достъп се намират в самия URL адрес, затова цялото поле се съхранява шифровано и никога не се показва отново; списъкът с връзки показва само името на всяка услуга, а за услуга на ваш собствен сървър — и този сървър."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo може да се свърже с вас тук"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Изпращайте известията на Postulo чрез Apprise до Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, имейл и над сто други услуги. Всяка се задава с един адрес, който съдържа данните ѝ за достъп и се съхранява шифрован."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr "Изключено на този екземпляр: %(services)s. Администратор може да го включи."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Услугите не отговориха в рамките на %(seconds)d секунди."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Известия към външни услуги чрез Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Това е тестовото съобщение от вашата връзка с Apprise. Напомнянията и прихващанията ще пристигат по същия начин."
