#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(host)s-এ %(service)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Apprise URL"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "অন্তত একটি Apprise URL দরকার।"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "অন্তত একটি পরিষেবা বার্তাটি প্রত্যাখ্যান করেছে।"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "লাইন %(line)d এমন কোনো Apprise URL নয় যা এই সংস্করণ বোঝে (%(scheme)s)।"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "প্রতি লাইনে একটি, Apprise-এর রূপে: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, এবং Apprise-এর তালিকায় থাকা অন্য যেকোনোটি। লগইনের তথ্য URL-এর ভেতরেই থাকে, তাই পুরো ফিল্ডটি এনক্রিপ্ট করে সংরক্ষণ করা হয় এবং আর কখনও দেখানো হয় না; সংযোগের তালিকায় প্রতিটি পরিষেবার নাম দেখানো হয়, সিক্রেট অংশগুলো ঢেকে রেখে।"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo এখানে আপনার কাছে পৌঁছাতে পারে"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "এটি আপনার Apprise সংযোগ থেকে পাঠানো পরীক্ষামূলক বার্তা। অনুস্মারক ও ক্যাপচারও একইভাবে আসবে।"
