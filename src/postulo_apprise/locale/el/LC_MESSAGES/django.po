#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s στο %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Διευθύνσεις URL Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "Χρειάζεται τουλάχιστον μία διεύθυνση URL Apprise."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Τουλάχιστον μία υπηρεσία απέρριψε το μήνυμα."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Η γραμμή %(line)d δεν είναι διεύθυνση URL Apprise που καταλαβαίνει αυτή η έκδοση (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Μία ανά γραμμή, στη μορφή του Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, και οποιαδήποτε άλλη από όσες απαριθμεί το Apprise. Τα διαπιστευτήρια βρίσκονται μέσα στη διεύθυνση URL, οπότε ολόκληρο το πεδίο αποθηκεύεται κρυπτογραφημένο και δεν εμφανίζεται ποτέ ξανά· η λίστα συνδέσεων κατονομάζει κάθε υπηρεσία με τα μυστικά μέρη καλυμμένα."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Εδώ μπορεί να σας βρει το Postulo"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Αυτό είναι το δοκιμαστικό μήνυμα από τη σύνδεσή σας με το Apprise. Οι υπενθυμίσεις και οι συλλήψεις θα φτάνουν με τον ίδιο τρόπο."
