msgstr "(iii) Kutoa huduma kwa wateja."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Delivered to %(count)d services."
msgstr "Huduma kwa wateja %(count)d."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Mstari %(line)d si URL ya kuingia ambayo toleo hili linaelewa (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Moja kwa kila mstari, katika fomu ya Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@ example.org, na orodha yoyote ya orodha. Vyeti vya kuishi ndani ya URL, hivyo shamba lote limehifadhiwa kwa encrypted na kamwe kuonyeshwa tena; orodha ya uhusiano kila huduma na sehemu za siri zilizofunikwa."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Ulo Unaweza Kuipata Hapa"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Hii ni ujumbe wa mtihani kutoka kwa uunganisho wako wa kuingia. Kumbukumbu na kumbukumbu zitafika kwa njia sawa."
