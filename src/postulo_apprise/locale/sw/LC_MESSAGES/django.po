msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Muunganisho mmoja hubeba URL %(count)d ya Apprise kwa upeo."
msgstr[1] "Muunganisho mmoja hubeba URL %(count)d za Apprise kwa upeo."

