#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s на %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Підключення містить щонайбільше %(count)d URL-адресу Apprise."
msgstr[1] "Підключення містить щонайбільше %(count)d URL-адреси Apprise."
msgstr[2] "Підключення містить щонайбільше %(count)d URL-адрес Apprise."

#: src/postulo_apprise/services.py
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr "Діє на машині, на якій працює Postulo, а не на вашому сервісі, тож його не можна використовувати."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL-адреси Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Потрібна принаймні одна URL-адреса Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Принаймні одна служба відхилила повідомлення."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Доставлено до %(count)d служби."
msgstr[1] "Доставлено до %(count)d служб."
msgstr[2] "Доставлено до %(count)d служб."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Рядок %(line)d (%(scheme)s) діє на комп’ютері, де працює Postulo, а не на вашій службі, тому його тут не можна використати."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Рядок %(line)d вимагає переходити за переспрямуваннями; Postulo ніколи цього не робить, тож вкажіть кінцеву адресу."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Рядок %(line)d — це не URL-адреса Apprise, яку розуміє ця версія (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Рядок %(line)d вказує на файл на комп’ютері, де працює Postulo (%(argument)s=). Натомість вкажіть адресу https."

#: src/postulo_apprise/services.py
msgid "Needs {packages}, which is not installed on this machine."
msgstr "Потрібен {packages}, який не встановлено на цій машині."

#: src/postulo_apprise/services.py
msgid "Not available on this machine."
msgstr "Недоступно на цій машині."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "По одній на рядок, у форматі Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org і будь-які інші, що їх перелічує Apprise. Облікові дані містяться в самій URL-адресі, тому все поле зберігається зашифрованим і більше ніколи не показується; у списку підключень видно лише назву кожної служби, а для служби на вашому власному сервері — цей сервер."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Тут Postulo може з вами зв’язатися"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Надсилайте сповіщення Postulo через Apprise до Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, на електронну пошту та до понад сотні інших служб. Кожну задає одна адреса, яка містить її облікові дані й зберігається зашифрованою."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr "Вимкнено на цьому екземплярі: %(services)s. Адміністратор може його ввімкнути."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Служби не відповіли протягом %(seconds)d с."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Сторонні сповіщення через Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Це тестове повідомлення від вашого підключення Apprise. Нагадування й захоплення надходитимуть так само."
