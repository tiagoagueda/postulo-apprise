#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s в %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] ""
msgstr[1] "З'єднання ведеться в більшості %(count)d Застосувати URL."
msgstr[2] "З'єднання ведеться в більшості %(count)d Застосувати URL."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Проксимус"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Налаштування URL"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "Принаймні потрібна одна URL-адреса."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Попри те, що одна послуга відмовилася від повідомлення."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] ""
msgstr[1] "Послуги %(count)d."
msgstr[2] "Послуги %(count)d."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Лінія %(line)d (%(scheme)s) діє на машині Postulo, не на службі вашої, тому тут не можна використовувати."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Лінія %(line)d попросить перенаправлення, щоб слідувати; Postulo ніколи не стежить за собою, щоб дати кінцеву адресу."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Лінія %(line)d не є URL-адресою Apprise цієї версії розуміє (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Лінія %(line)d іменує файл на машині Postulo працює (%(argument)s=). Подаруйте адресу HTTPS замість."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Один рядок, у формі Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, і будь-який з інших списку додатків. Список з'єднань показує тільки ім'я кожного сервісу і, для одного на сервері власного, цього сервера."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo може дістатися до вас тут"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Сервіси не відповіли за секундами %(seconds)d."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Це тестове повідомлення від вашого підключення Apprise. Перемінники і захоплення прибудуть таким же чином."
