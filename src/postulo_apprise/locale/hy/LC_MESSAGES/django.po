#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s (%(host)s)՝ %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Կապը կարող է պարունակել առավելագույնը %(count)d Apprise URL։"
msgstr[1] "Կապը կարող է պարունակել առավելագույնը %(count)d Apprise URL։"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Apprise URL-ներ"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "Անհրաժեշտ է առնվազն մեկ Apprise URL։"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Առնվազն մեկ ծառայություն մերժեց հաղորդագրությունը։"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Առաքվեց %(count)d ծառայության։"
msgstr[1] "Առաքվեց %(count)d ծառայության։"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "%(line)d տողը (%(scheme)s) գործում է այն մեքենայի վրա, որտեղ աշխատում է Postulo-ն, և ոչ թե ձեր որևէ ծառայության վրա, ուստի այն այստեղ չի կարող օգտագործվել։"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "%(line)d տողը պահանջում է հետևել վերահղումներին․ Postulo-ն երբեք չի հետևում դրանց, ուստի նշեք վերջնական հասցեն։"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Տող %(line)d՝ սա այնպիսի Apprise URL չէ, որը հասկանում է այս տարբերակը (%(scheme)s)։"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "%(line)d տողը նշում է ֆայլ այն մեքենայի վրա, որտեղ աշխատում է Postulo-ն (%(argument)s=)։ Փոխարենը նշեք https հասցե։"

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Մեկ տողում՝ մեկը, Apprise-ի ձևով՝ tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org և Apprise-ի թվարկած մյուսներից ցանկացածը։ Մուտքի տվյալները գտնվում են URL-ի ներսում, ուստի ամբողջ դաշտը պահվում է գաղտնագրված և այլևս երբեք չի ցուցադրվում․ կապերի ցանկը ցույց է տալիս միայն յուրաքանչյուր ծառայության անունը, իսկ ձեր սեփական սերվերի վրա գտնվողի համար՝ նաև այդ սերվերը։"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo-ն կարող է ձեզ հետ կապվել այստեղ"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Ուղարկեք Postulo-ի ծանուցումները Apprise-ի միջոցով Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, էլ. փոստ և հարյուրից շատ ավելի այլ ծառայություններ։ Յուրաքանչյուրը նշվում է մեկ հասցեով, որը պարունակում է իր մուտքի տվյալները և պահվում է գաղտնագրված։"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Ծառայությունները չպատասխանեցին %(seconds)d վայրկյանի ընթացքում։"

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Երրորդ կողմի ծանուցումներ Apprise-ի միջոցով"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Սա ձեր Apprise կապի փորձնական հաղորդագրությունն է։ Հիշեցումներն ու որսերը կհասնեն նույն ձևով։"
