#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Aprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "URL de l' Aprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "Cal un URL de l'Aprise com a mínim."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Almenys un servei ha rebutjat el missatge."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "La línia %(line)d no és un URL de l' Apprise aquesta versió entén (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Una per línia, en forma de l'Apprise: tgram://bot- token/chat- id, ntfy://te tema, discordòrdia://web-id/webmundete-token, mail a // usuari: password@ exemple.org i qualsevol de les altres llistes de l'Apris. Les credencials viuen dins de l' URL, de manera que el camp sencer està emmagatzemat xifrat i no es torna a mostrar; els noms de la llista de connexions cada servei amb les parts secretes emmascascarada."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo pot arribar fins aquí"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Aquest és el missatge de prova de la connexió de l'Aprise. Els recordatoris i les captures arribaran de la mateixa manera."
