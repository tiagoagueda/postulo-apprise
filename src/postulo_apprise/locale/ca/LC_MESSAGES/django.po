#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s a %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Una connexió pot contenir com a màxim %(count)d URL de l'Apprise."
msgstr[1] "Una connexió pot contenir com a màxim %(count)d URL de l'Apprise."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL de l'Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Cal com a mínim un URL de l'Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Almenys un servei ha rebutjat el missatge."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "S'ha lliurat a %(count)d servei."
msgstr[1] "S'ha lliurat a %(count)d serveis."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "La línia %(line)d (%(scheme)s) actua sobre la màquina on s'executa Postulo, no sobre un servei vostre, de manera que no es pot fer servir aquí."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "La línia %(line)d demana que se segueixin les redireccions; Postulo no en segueix mai cap, així que indiqueu l'adreça final."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "La línia %(line)d no és un URL de l'Apprise que aquesta versió entengui (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "La línia %(line)d indica un fitxer de la màquina on s'executa Postulo (%(argument)s=). Indiqueu-hi una adreça https."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Una per línia, en el format de l'Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org i qualsevol dels altres que l'Apprise inclou a la seva llista. Les credencials són dins de l'URL, de manera que tot el camp es desa xifrat i no es torna a mostrar mai; la llista de connexions només mostra el nom de cada servei i, si és en un servidor vostre, aquest servidor."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo us pot avisar per aquí"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Envia les notificacions de Postulo a través de l'Apprise a Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, el correu electrònic i més d'un centenar d'altres serveis. Cadascun s'identifica amb una adreça, que conté la seva credencial i es desa xifrada."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Els serveis no han respost en %(seconds)d segons."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Notificacions de tercers mitjançant l'Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Aquest és el missatge de prova de la vostra connexió de l'Apprise. Els recordatoris i les captures arribaran de la mateixa manera."
