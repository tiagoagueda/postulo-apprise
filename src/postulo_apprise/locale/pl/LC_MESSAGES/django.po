#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s na %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Połączenie może zawierać najwyżej %(count)d adres URL Apprise."
msgstr[1] "Połączenie może zawierać najwyżej %(count)d adresy URL Apprise."
msgstr[2] "Połączenie może zawierać najwyżej %(count)d adresów URL Apprise."

#: src/postulo_apprise/services.py
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr "Działa na maszynie, na której działa Postulo, a nie na Twojej usłudze, więc nie można go używać."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Adresy URL Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Potrzebny jest co najmniej jeden adres URL Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Co najmniej jedna usługa odrzuciła wiadomość."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Dostarczono do %(count)d usługi."
msgstr[1] "Dostarczono do %(count)d usług."
msgstr[2] "Dostarczono do %(count)d usług."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Wiersz %(line)d (%(scheme)s) działa na serwerze, na którym działa Postulo, a nie w Twojej usłudze, więc nie można go tu użyć."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Wiersz %(line)d wymaga podążania za przekierowaniami; Postulo nigdy za nimi nie podąża, więc podaj adres docelowy."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Wiersz %(line)d nie jest adresem URL Apprise, który ta wersja rozumie (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Wiersz %(line)d wskazuje plik na serwerze, na którym działa Postulo (%(argument)s=). Zamiast tego podaj adres https."

#: src/postulo_apprise/services.py
msgid "Needs {packages}, which is not installed on this machine."
msgstr "Wymaga pakietu {packages}, który nie jest zainstalowany na tej maszynie."

#: src/postulo_apprise/services.py
msgid "Not available on this machine."
msgstr "Niedostępne na tej maszynie."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Po jednym w wierszu, w formacie Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org oraz dowolny inny z listy Apprise. Dane uwierzytelniające są zawarte w adresie URL, więc całe pole jest przechowywane w postaci zaszyfrowanej i nigdy więcej nie jest wyświetlane; lista połączeń pokazuje tylko nazwę każdej usługi, a w przypadku usługi na Twoim własnym serwerze – także ten serwer."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Tu Postulo może do Ciebie dotrzeć"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Wysyłaj powiadomienia Postulo przez Apprise do usług Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, na e-mail i do ponad stu innych. Każdą z nich określa jeden adres, który zawiera jej dane uwierzytelniające i jest przechowywany w postaci zaszyfrowanej."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr "Wyłączone w tej instancji: %(services)s. Administrator może to włączyć."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Usługi nie odpowiedziały w ciągu %(seconds)d sekund."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Powiadomienia w usługach zewnętrznych przez Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "To jest wiadomość testowa z Twojego połączenia Apprise. Przypomnienia i przechwycenia będą docierać w ten sam sposób."
