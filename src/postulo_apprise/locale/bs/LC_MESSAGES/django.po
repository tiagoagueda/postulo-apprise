#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s na %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Apprise URL adrese"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "Potrebna je barem jedna Apprise URL adresa."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Barem jedna usluga je odbila poruku."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Red %(line)d nije Apprise URL adresa koju ova verzija razumije (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Jedna po redu, u Apprise obliku: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org i bilo koja druga koju Apprise navodi. Pristupni podaci nalaze se u samoj URL adresi, pa se cijelo polje pohranjuje šifrirano i nikad se više ne prikazuje; spisak veza imenuje svaku uslugu s maskiranim tajnim dijelovima."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Ovdje vas Postulo može kontaktirati"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Ovo je testna poruka s vaše Apprise veze. Podsjetnici i hvatanja stizat će na isti način."
