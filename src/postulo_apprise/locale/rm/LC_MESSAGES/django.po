#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s sin %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Ina connexiun cuntegna maximalmain %(count)d URL dad Apprise."
msgstr[1] "Ina connexiun cuntegna maximalmain %(count)d URLs dad Apprise."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "URLs dad Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "I dovra almain in URL dad Apprise."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Almain in servetsch ha refusà il messadi."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Furnì a %(count)d servetsch."
msgstr[1] "Furnì a %(count)d servetschs."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "La lingia %(line)d (%(scheme)s) agescha sin la maschina, sin la quala Postulo funcziuna, e betg sin in da Voss servetschs, perquai na po ella betg vegnir utilisada qua."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "La lingia %(line)d dumonda da suandar renviaments; Postulo na suonda mai in, perquai indicai l'adressa finala."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "La lingia %(line)d n'è betg in URL dad Apprise che questa versiun chapescha (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "La lingia %(line)d numna ina datoteca sin la maschina, sin la quala Postulo funcziuna (%(argument)s=). Indicai empè in'adressa https."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "In per lingia, en la furma dad Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, e tut ils auters che Apprise enumerescha. Las datas d'access sa chattan en l'URL, perquai vegn l'entir champ memorisà criptà e mai pli mussà; la glista da las connexiuns mussa mo il num da mintga servetsch e, per in sin in agen server, quel server."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo As po cuntanscher qua"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Ils servetschs n'han betg respundì entaifer %(seconds)d secundas."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Quai è il messadi da test da Vossa connexiun Apprise. Promemorias e registraziuns arrivan da la medema moda."
