#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s di %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Diperlukan setidaknya satu URL Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Setidaknya satu layanan menolak pesan."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Baris %(line)d bukan URL Apprise yang dipahami versi ini (%(scheme)s)."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Satu per baris, dalam format Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, dan layanan lain yang tercantum di Apprise. Kredensial berada di dalam URL, sehingga seluruh kolom disimpan terenkripsi dan tidak pernah ditampilkan lagi; daftar koneksi menyebutkan setiap layanan dengan bagian rahasianya disamarkan."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo dapat menjangkau Anda di sini"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Ini adalah pesan uji dari koneksi Apprise Anda. Pengingat dan tangkapan akan tiba dengan cara yang sama."
