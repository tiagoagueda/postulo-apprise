#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s aadressil %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Ühendus mahutab kõige rohkem %(count)d Apprise’i URL-i."
msgstr[1] "Ühendus mahutab kõige rohkem %(count)d Apprise’i URL-i."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise’i URL-id"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Vaja on vähemalt ühte Apprise’i URL-i."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Vähemalt üks teenus lükkas sõnumi tagasi."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Edastatud %(count)d teenusele."
msgstr[1] "Edastatud %(count)d teenusele."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Rida %(line)d (%(scheme)s) toimib arvutis, kus Postulo töötab, mitte mõnes teie teenuses, seega ei saa seda siin kasutada."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Rida %(line)d palub ümbersuunamisi järgida; Postulo ei järgi neid kunagi, seega sisestage lõplik aadress."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Rida %(line)d ei ole Apprise’i URL, mida see versioon mõistab (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Rida %(line)d viitab failile arvutis, kus Postulo töötab (%(argument)s=). Sisestage selle asemel https-aadress."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Üks rea kohta, Apprise’i kujul: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org ja kõik muud, mida Apprise loetleb. Juurdepääsuandmed asuvad URL-i sees, seega salvestatakse kogu väli krüptitult ja seda ei näidata enam kunagi; ühenduste loendis on ainult iga teenuse nimi ja teie enda serveris oleva teenuse puhul see server."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo saab teiega siin ühendust"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Saatke Postulo teavitused Apprise’i kaudu teenustesse Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, e-post ja enam kui sada muud. Iga teenus on määratud ühe aadressiga, mis sisaldab selle juurdepääsuandmeid ja salvestatakse krüptitult."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Teenused ei vastanud %(seconds)d sekundi jooksul."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Kolmanda osapoole teavitused Apprise’i kaudu"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "See on teie Apprise’i ühenduse testsõnum. Meeldetuletused ja jäädvustused saabuvad samamoodi."
