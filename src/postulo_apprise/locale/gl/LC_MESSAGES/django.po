#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s en %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL de Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Precísase polo menos unha URL de Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Polo menos un servizo rexeitou a mensaxe."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgstr "Entregada a %(count)d servizo."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d services."
msgstr "Entregada a %(count)d servizos."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "A liña %(line)d non é unha URL de Apprise que entenda esta versión (%(scheme)s)."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Unha por liña, no formato de Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, e calquera das outras que lista Apprise. As credenciais van dentro da URL, polo que todo o campo se almacena cifrado e nunca se volve mostrar; a lista de conexións nomea cada servizo coas partes secretas ocultas."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Aquí o Postulo pode avisarte"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Esta é a mensaxe de proba da túa conexión de Apprise. Os recordatorios e as capturas chegarán do mesmo xeito."
