#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s en %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Unha conexión admite como máximo %(count)d URL de Apprise."
msgstr[1] "Unha conexión admite como máximo %(count)d URL de Apprise."

#: src/postulo_apprise/services.py
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr "Actúa sobre a máquina na que se executa Postulo, non sobre un servizo teu, polo que non se pode usar."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL de Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Precísase polo menos unha URL de Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Polo menos un servizo rexeitou a mensaxe."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Entregado a %(count)d servizo."
msgstr[1] "Entregado a %(count)d servizos."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "A liña %(line)d (%(scheme)s) actúa sobre a máquina na que se executa o Postulo, non sobre un servizo teu, así que non se pode usar aquí."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "A liña %(line)d pide que se sigan as redireccións; o Postulo nunca segue ningunha, así que indica o enderezo final."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "A liña %(line)d non é unha URL de Apprise que entenda esta versión (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "A liña %(line)d indica un ficheiro na máquina na que se executa o Postulo (%(argument)s=). Indica no seu lugar un enderezo https."

#: src/postulo_apprise/services.py
msgid "Needs {packages}, which is not installed on this machine."
msgstr "Precisa {packages}, que non está instalado nesta máquina."

#: src/postulo_apprise/services.py
msgid "Not available on this machine."
msgstr "Non dispoñible nesta máquina."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Un por liña, na forma de Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, e calquera dos outros que enumera Apprise. As credenciais van dentro do URL, así que todo o campo se almacena cifrado e nunca se volve mostrar; a lista de conexións mostra só o nome de cada servizo e, se está nun servidor propio, ese servidor."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Aquí o Postulo pode avisarte"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Envía as notificacións de Postulo a través de Apprise a Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, correo electrónico e moito máis dun centenar doutros servizos. Cada un identifícase cun enderezo, que contén a súa credencial e se garda cifrado."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr "Desactivado nesta instancia: %(services)s. Un administrador pode activalo."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Os servizos non responderon en %(seconds)d segundos."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Notificacións de terceiros vía Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Esta é a mensaxe de proba da túa conexión de Apprise. Os recordatorios e as capturas chegarán do mesmo xeito."
