#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s na %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Adresy URL Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "Je potrebná aspoň jedna adresa URL Apprise."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Aspoň jedna služba správu odmietla."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Riadok %(line)d nie je adresa URL Apprise, ktorej táto verzia rozumie (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Jedna na riadok, v tvare Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org a ktorákoľvek ďalšia, ktorú Apprise uvádza. Prihlasovacie údaje sú súčasťou adresy URL, preto sa celé pole ukladá šifrovane a už sa nikdy nezobrazí; zoznam pripojení uvádza každú službu s maskovanými tajnými časťami."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo vás tu zastihne"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Toto je skúšobná správa z vášho pripojenia Apprise. Pripomienky a zachytenia prídu rovnakou cestou."
