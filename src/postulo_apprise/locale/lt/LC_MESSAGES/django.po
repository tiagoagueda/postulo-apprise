#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s, serveris %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise URL adresai"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Reikia bent vieno Apprise URL adreso."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Bent viena paslauga atmetė pranešimą."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Eilutė %(line)d nėra Apprise URL, kurį supranta ši versija (%(scheme)s)."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Po vieną eilutėje, Apprise formatu: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org arba bet kuris kitas Apprise palaikomas adresas. Prisijungimo duomenys yra pačiame URL, todėl visas laukas saugomas užšifruotas ir daugiau niekada nerodomas; ryšių sąraše kiekviena paslauga įvardijama, o slaptos dalys užmaskuotos."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo gali jus pasiekti čia"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Tai bandomasis pranešimas iš jūsų Apprise ryšio. Priminimai ir fiksavimai atkeliaus tuo pačiu būdu."
