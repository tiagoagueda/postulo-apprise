#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Po vieną eilutėje, Apprise forma: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org ir bet kuris kitas iš Apprise sąrašo. Prisijungimo duomenys yra pačiame URL adrese, todėl visas laukas saugomas užšifruotas ir daugiau niekada nerodomas; ryšių sąraše kiekviena paslauga įvardijama su užmaskuotomis slaptomis dalimis."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo gali jus pasiekti čia"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Tai bandomasis pranešimas iš jūsų Apprise ryšio. Priminimai ir fiksavimai atkeliaus tuo pačiu būdu."
