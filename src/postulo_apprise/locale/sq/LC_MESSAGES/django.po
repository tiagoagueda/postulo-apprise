#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s në %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Një lidhje mban më së shumti %(count)d URL të Apprise."
msgstr[1] "Një lidhje mban më së shumti %(count)d URL të Apprise."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL-të e Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Nevojitet të paktën një URL e Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Të paktën një shërbim refuzoi mesazhin."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "U dorëzua te %(count)d shërbim."
msgstr[1] "U dorëzua te %(count)d shërbime."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Rreshti %(line)d (%(scheme)s) vepron në makinën ku ekzekutohet Postulo, jo në një shërbim tuajin, prandaj nuk mund të përdoret këtu."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Rreshti %(line)d kërkon që të ndiqen ridrejtimet; Postulo nuk ndjek kurrë asnjë, prandaj jepni adresën përfundimtare."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Rreshti %(line)d nuk është një URL Apprise që e kupton ky version (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Rreshti %(line)d tregon një skedar në makinën ku ekzekutohet Postulo (%(argument)s=). Jepni një adresë https në vend të saj."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Një për rresht, në formën e Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, dhe cilido nga të tjerët që liston Apprise. Kredencialet ndodhen brenda URL-së, ndaj e gjithë fusha ruhet e enkriptuar dhe nuk shfaqet më kurrë; lista e lidhjeve tregon vetëm emrin e çdo shërbimi dhe, për një shërbim në një server tuajin, atë server."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo mund t'ju kontaktojë këtu"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Dërgoni njoftimet e Postulo-s përmes Apprise te Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email dhe mbi njëqind shërbime të tjera. Secili identifikohet nga një adresë, e cila mban kredencialet e tij dhe ruhet e enkriptuar."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Shërbimet nuk u përgjigjën brenda %(seconds)d sekondash."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Njoftime te shërbime të palëve të treta përmes Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Ky është mesazhi provë nga lidhja juaj me Apprise. Kujtesat dhe kapjet do të vijnë në të njëjtën mënyrë."
