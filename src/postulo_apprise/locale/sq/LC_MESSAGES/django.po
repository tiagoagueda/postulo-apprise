#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Një për vijë, në formën e Apprease: tgram://bot-token/chat-id, ntfy://topic, mosmarrëveshje://webuk-id/webhook-token, mailto://user: Chword@examp.org, dhe secila prej listave të tjera të Appise. Kredencialet jetojnë brenda URL-së, kështu që e gjithë fusha ruhet e kriptuar dhe nuk tregohet më kurrë; lidhjet lista me emrat e çdo shërbimi me pjesët e fshehta të maskuara."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Populo mund të të arrijë këtu"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Ky është mesazhi i testimit nga lidhja juaj me Appise. Kujtuesit dhe kapësit do të vijnë në të njëjtën mënyrë."
