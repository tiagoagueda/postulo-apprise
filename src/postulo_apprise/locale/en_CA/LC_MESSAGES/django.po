#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s at %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "A connection holds at most %(count)d Apprise URL."
msgstr[1] "A connection holds at most %(count)d Apprise URLs."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise URLs"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "At least one Apprise URL is needed."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "At least one service refused the message."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Delivered to %(count)d service."
msgstr[1] "Delivered to %(count)d services."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo can reach you here"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "The services did not answer within %(seconds)d seconds."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Third-party notifications via Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
