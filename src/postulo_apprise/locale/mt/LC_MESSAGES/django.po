#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s fuq %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "URLs ta' Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "Hemm bżonn mill-inqas URL waħda ta' Apprise."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "Mill-inqas servizz wieħed irrifjuta l-messaġġ."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Il-linja %(line)d mhijiex URL ta' Apprise li din il-verżjoni tifhem (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Waħda f'kull linja, fil-forma ta' Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, u kwalunkwe oħra minn dawk li jelenka Apprise. Il-kredenzjali jinsabu ġewwa l-URL, għalhekk il-kamp kollu jinħażen kriptat u qatt ma jintwera iżjed; il-lista tal-konnessjonijiet issemmi kull servizz bil-partijiet sigrieti moħbija."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo jista' jilħqek hawn"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Dan huwa l-messaġġ ta' prova mill-konnessjoni Apprise tiegħek. It-tfakkiriet u l-qbidiet jaslu bl-istess mod."
