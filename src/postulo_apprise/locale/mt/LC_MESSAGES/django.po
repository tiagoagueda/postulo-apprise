#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s fuq %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Konnessjoni żżomm l-aktar %(count)d URL ta' Apprise."
msgstr[1] "Konnessjoni żżomm l-aktar %(count)d URLs ta' Apprise."
msgstr[2] "Konnessjoni żżomm l-aktar %(count)d URL ta' Apprise."
msgstr[3] "Konnessjoni żżomm l-aktar %(count)d URL ta' Apprise."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr "Jaġixxi fuq il-magna li fuqha jaħdem Postulo, mhux fuq servizz tiegħek, għalhekk ma jistax jintuża."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URLs ta' Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Hemm bżonn mill-inqas URL waħda ta' Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Mill-inqas servizz wieħed irrifjuta l-messaġġ."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Ikkonsenjat lil %(count)d servizz."
msgstr[1] "Ikkonsenjat lil %(count)d servizzi."
msgstr[2] "Ikkonsenjat lil %(count)d servizz."
msgstr[3] "Ikkonsenjat lil %(count)d servizz."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Il-linja %(line)d (%(scheme)s) taġixxi fuq il-magna fejn jaħdem Postulo, mhux fuq servizz tiegħek, għalhekk ma tistax tintuża hawn."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Il-linja %(line)d titlob li jiġu segwiti r-ridirezzjonijiet; Postulo qatt ma jsegwi waħda, għalhekk agħti l-indirizz finali."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Il-linja %(line)d mhijiex URL ta' Apprise li din il-verżjoni tifhem (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Il-linja %(line)d issemmi fajl fuq il-magna fejn jaħdem Postulo (%(argument)s=). Agħti indirizz https minflok."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Needs {packages}, which is not installed on this machine."
msgstr "Jeħtieġ {packages}, li mhuwiex installat fuq din il-magna."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Not available on this machine."
msgstr "Mhux disponibbli fuq din il-magna."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Wieħed f'kull linja, fil-forma ta' Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, u kwalunkwe wieħed mill-oħrajn li jelenka Apprise. Il-kredenzjali jinsabu ġewwa l-URL, għalhekk il-qasam kollu jinħażen kriptat u qatt ma jerġa' jintwera; il-lista tal-konnessjonijiet turi biss l-isem ta' kull servizz u, għal wieħed fuq server tiegħek, dak is-server."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo jista' jilħqek hawn"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Ibgħat in-notifiki ta' Postulo permezz ta' Apprise lil Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, l-email u ferm aktar minn mitt servizz ieħor. Kull wieħed jissemma b'indirizz wieħed, li jżomm il-kredenzjali tiegħu u jinħażen kriptat."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr "Mitfi fuq din l-istanza: %(services)s. Amministratur jista' jixgħelu."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Is-servizzi ma wieġbux fi żmien %(seconds)d sekondi."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Notifiki ta' partijiet terzi permezz ta' Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Dan huwa l-messaġġ ta' prova mill-konnessjoni Apprise tiegħek. It-tfakkiriet u l-qbid jaslu bl-istess mod."
