#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s en %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Una conexión tiene en la mayoría %(count)d Apprise URL."
msgstr[1] "Una conexión tiene en la mayoría %(count)d Aplicar URLs."

#: src/postulo_apprise/notifier.py
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL de Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Se necesita al menos una URL de Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Al menos un servicio rechazó el mensaje."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Entregado al servicio %(count)d."
msgstr[1] "Entregado a %(count)d servicios."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "La línea %(line)d (%(scheme)s) actúa en la máquina Postulo funciona, no en un servicio suyo, por lo que no se puede utilizar aquí."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "La línea %(line)d pide que se sigan las redirecciones; Postulo nunca sigue una, así que da la dirección final."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "La línea %(line)d no es una URL de Apprise que esta versión entienda (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Line %(line)d nombra un archivo en la máquina Postulo funciona en (%(argument)s=). Dar una dirección https en su lugar."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. Las credenciales viven dentro de la URL, por lo que todo el campo se almacena encriptado y nunca se muestra de nuevo; la lista de conexiones muestra sólo el nombre de cada servicio y, para uno en un servidor propio, ese servidor."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo puede contactarte aquí"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Los servicios no respondieron dentro de %(seconds)d segundos."

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Este es el mensaje de prueba de tu conexión de Apprise. Los recordatorios y las capturas llegarán de la misma manera."
