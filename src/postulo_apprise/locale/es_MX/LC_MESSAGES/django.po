#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s en %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL de Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Se necesita al menos una URL de Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Al menos un servicio rechazó el mensaje."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgstr "Se entregó a %(count)d servicio."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d services."
msgstr "Se entregó a %(count)d servicios."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "La línea %(line)d no es una URL de Apprise que esta versión entienda (%(scheme)s)."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Una por línea, en el formato de Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org y cualquiera de los demás que Apprise enumera. Las credenciales van dentro de la URL, así que todo el campo se guarda cifrado y no se vuelve a mostrar; la lista de conexiones nombra cada servicio con las partes secretas ocultas."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo puede contactarte aquí"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Este es el mensaje de prueba de tu conexión de Apprise. Los recordatorios y las capturas llegarán de la misma manera."
