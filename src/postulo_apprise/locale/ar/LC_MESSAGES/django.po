#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s على %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "لا يقبل الاتصال أي عنوان Apprise."
msgstr[1] "يقبل الاتصال عنوان Apprise واحدًا على الأكثر."
msgstr[2] "يقبل الاتصال %(count)d من عناوين Apprise على الأكثر."
msgstr[3] "يقبل الاتصال %(count)d عناوين Apprise على الأكثر."
msgstr[4] "يقبل الاتصال %(count)d من عناوين Apprise على الأكثر."
msgstr[5] "يقبل الاتصال %(count)d من عناوين Apprise على الأكثر."

#: src/postulo_apprise/services.py
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr ""

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "عناوين Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "يلزم عنوان Apprise واحد على الأقل."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "رفضت خدمة واحدة على الأقل الرسالة."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "لم يُسلَّم إلى أي خدمة."
msgstr[1] "سُلِّم إلى خدمة واحدة."
msgstr[2] "سُلِّم إلى %(count)d خدمتين."
msgstr[3] "سُلِّم إلى %(count)d خدمات."
msgstr[4] "سُلِّم إلى %(count)d خدمةً."
msgstr[5] "سُلِّم إلى %(count)d خدمة."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "السطر %(line)d (%(scheme)s) يعمل على الجهاز الذي يشغّل Postulo، لا على خدمة تخصّك، لذا لا يمكن استخدامه هنا."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "يطلب السطر %(line)d اتباع عمليات إعادة التوجيه؛ لا يتبع Postulo أيًّا منها أبدًا، لذا أدخِل العنوان النهائي."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "السطر %(line)d ليس عنوان Apprise يفهمه هذا الإصدار (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "السطر %(line)d يشير إلى ملف على الجهاز الذي يشغّل Postulo (%(argument)s=). أدخِل عنوان https بدلًا من ذلك."

#: src/postulo_apprise/services.py
msgid "Needs {packages}, which is not installed on this machine."
msgstr ""

#: src/postulo_apprise/services.py
msgid "Not available on this machine."
msgstr ""

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "عنوان واحد في كل سطر، بصيغة Apprise: tgram://bot-token/chat-id، ntfy://topic، discord://webhook-id/webhook-token، mailto://user:password@example.org، وأي عنوان آخر من العناوين التي يدرجها Apprise. بيانات الاعتماد موجودة داخل العنوان، لذا يُخزَّن الحقل كاملًا مشفّرًا ولا يُعرض مرة أخرى أبدًا؛ ولا تُظهر قائمة الاتصالات إلا اسم كل خدمة، ومعه الخادم إن كانت الخدمة على خادم خاص بك."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "يستطيع Postulo الوصول إليك هنا"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "إرسال إشعارات Postulo عبر Apprise إلى Telegram وntfy وDiscord وMatrix وGotify وPushover وSignal والبريد الإلكتروني وأكثر من مئة خدمة أخرى. تُحدَّد كل خدمة بعنوان واحد يتضمّن بيانات اعتمادها ويُخزَّن مشفّرًا."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr ""

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "لم تستجب الخدمات خلال %(seconds)d ثانية."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "إشعارات خارجية عبر Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "هذه رسالة الاختبار من اتصال Apprise الخاص بك. ستصل التذكيرات والالتقاطات بالطريقة نفسها."
