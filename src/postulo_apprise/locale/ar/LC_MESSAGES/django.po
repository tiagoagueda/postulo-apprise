#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s على %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "عناوين Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "يلزم عنوان Apprise واحد على الأقل."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "رفضت خدمة واحدة على الأقل الرسالة."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "السطر %(line)d ليس عنوان Apprise يفهمه هذا الإصدار (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "عنوان واحد في كل سطر، بالصيغة التي يستخدمها Apprise: tgram://bot-token/chat-id، ntfy://topic، discord://webhook-id/webhook-token، mailto://user:password@example.org، وأي من الخدمات الأخرى التي يذكرها Apprise. بيانات الاعتماد موجودة داخل العنوان، لذا يُخزَّن الحقل كاملًا مشفّرًا ولا يُعرض مرة أخرى؛ وتذكر قائمة الاتصالات كل خدمة مع إخفاء الأجزاء السرية."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "يستطيع Postulo الوصول إليك هنا"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "هذه رسالة الاختبار من اتصال Apprise الخاص بك. ستصل التذكيرات وعمليات الالتقاط بالطريقة نفسها."
