#: src/postulo_apprise/notifier.py:185
#, python-format, draft
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s uz %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py:133
#, draft
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py:139
#, draft
msgid "Apprise URLs"
msgstr "Apprise URL adreses"

#: src/postulo_apprise/notifier.py:170
#, draft
msgid "At least one Apprise URL is needed."
msgstr "Nepieciešama vismaz viena Apprise URL adrese."

#: src/postulo_apprise/notifier.py:225 src/postulo_apprise/notifier.py:237
#, draft
msgid "At least one service refused the message."
msgstr "Vismaz viens pakalpojums noraidīja ziņu."

#: src/postulo_apprise/notifier.py:219
#, python-format, draft
msgid "Delivered to %(count)d service."
msgstr "Piegādāts %(count)d pakalpojumam."

#: src/postulo_apprise/notifier.py:221
#, python-format, draft
msgid "Delivered to %(count)d services."
msgstr "Piegādāts %(count)d pakalpojumiem."

#: src/postulo_apprise/notifier.py:173
#, python-format, draft
msgid ""
"Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr ""
"%(line)d. rinda nav Apprise URL adrese, ko šī versija saprot (%(scheme)s)."

#: src/postulo_apprise/notifier.py:143
#, draft
msgid ""
"One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr ""
"Pa vienai katrā rindā, Apprise formā: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org un jebkura cita no Apprise saraksta. Akreditācijas dati atrodas pašā URL adresē, tāpēc viss lauks tiek glabāts šifrēti un vairs nekad netiek rādīts; savienojumu sarakstā katrs pakalpojums nosaukts ar aizklātām slepenajām daļām."

#: src/postulo_apprise/notifier.py:206
#, draft
msgid "Postulo can reach you here"
msgstr "Postulo var jūs sasniegt šeit"

#: src/postulo_apprise/notifier.py:208
#, draft
msgid ""
"This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr ""
"Šī ir testa ziņa no jūsu Apprise savienojuma. Atgādinājumi un tvērumi pienāks tāpat."
