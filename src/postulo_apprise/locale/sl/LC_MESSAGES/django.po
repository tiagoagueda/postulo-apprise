#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s na %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Povezava lahko vsebuje največ %(count)d URL Apprise."
msgstr[1] "Povezava lahko vsebuje največ %(count)d URL-ja Apprise."
msgstr[2] "Povezava lahko vsebuje največ %(count)d URL-je Apprise."
msgstr[3] "Povezava lahko vsebuje največ %(count)d URL-jev Apprise."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL-ji Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Potreben je vsaj en URL Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Vsaj ena storitev je sporočilo zavrnila."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Dostavljeno %(count)d storitvi."
msgstr[1] "Dostavljeno %(count)d storitvama."
msgstr[2] "Dostavljeno %(count)d storitvam."
msgstr[3] "Dostavljeno %(count)d storitvam."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Vrstica %(line)d (%(scheme)s) deluje na računalniku, na katerem teče Postulo, ne pa na kateri od vaših storitev, zato je tukaj ni mogoče uporabiti."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Vrstica %(line)d zahteva sledenje preusmeritvam; Postulo jim nikoli ne sledi, zato navedite končni naslov."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Vrstica %(line)d ni URL Apprise, ki bi ga ta različica razumela (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Vrstica %(line)d navaja datoteko na računalniku, na katerem teče Postulo (%(argument)s=). Namesto tega navedite naslov https."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "En URL na vrstico, v obliki, ki jo uporablja Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org in kateri koli drug, ki ga navaja Apprise. Poverilnice so zapisane v samem URL-ju, zato je celotno polje shranjeno šifrirano in nikoli več prikazano; seznam povezav prikaže le ime vsake storitve, pri storitvi na vašem lastnem strežniku pa še ta strežnik."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo vas lahko doseže tukaj"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Pošiljajte obvestila Postula prek Apprise v Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, e-pošto in več kot sto drugih storitev. Vsako določa en naslov, ki vsebuje njeno poverilnico in je shranjen šifrirano."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Storitve niso odgovorile v %(seconds)d sekundah."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Obvestila prek zunanjih storitev z Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "To je preizkusno sporočilo vaše povezave Apprise. Opomniki in zajemi bodo prispeli na enak način."
