#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s (%(host)s): %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "კავშირი მაქსიმუმ %(count)d Apprise URL-ს შეიცავს."
msgstr[1] "კავშირი მაქსიმუმ %(count)d Apprise URL-ს შეიცავს."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr "მოქმედებს მანქანაზე, რომელზეც Postulo მუშაობს, და არა თქვენს სერვისზე, ამიტომ მისი გამოყენება შეუძლებელია."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise-ის URL-ები"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "საჭიროა მინიმუმ ერთი Apprise URL."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "მინიმუმ ერთმა სერვისმა შეტყობინება უარყო."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "მიწოდებულია %(count)d სერვისზე."
msgstr[1] "მიწოდებულია %(count)d სერვისზე."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "სტრიქონი %(line)d (%(scheme)s) მოქმედებს იმ კომპიუტერზე, სადაც Postulo მუშაობს, და არა თქვენს რომელიმე სერვისზე, ამიტომ აქ მისი გამოყენება შეუძლებელია."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "სტრიქონი %(line)d ითხოვს გადამისამართებების მიყოლას; Postulo გადამისამართებას არასოდეს მიჰყვება, ამიტომ მიუთითეთ საბოლოო მისამართი."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "სტრიქონი %(line)d არ არის Apprise URL, რომელსაც ეს ვერსია იცნობს (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "სტრიქონი %(line)d ასახელებს ფაილს იმ კომპიუტერზე, სადაც Postulo მუშაობს (%(argument)s=). სანაცვლოდ მიუთითეთ https მისამართი."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Needs {packages}, which is not installed on this machine."
msgstr "საჭიროა {packages}, რომელიც ამ მანქანაზე დაყენებული არ არის."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Not available on this machine."
msgstr "ამ მანქანაზე მიუწვდომელია."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "თითო სტრიქონზე თითო, Apprise-ის ფორმით: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org და ნებისმიერი სხვა, რომელსაც Apprise ჩამოთვლის. ავტორიზაციის მონაცემები URL-შია, ამიტომ მთელი ველი დაშიფრულად ინახება და აღარასოდეს ჩანს; კავშირების სიაში ჩანს მხოლოდ თითოეული სერვისის სახელი და, თუ ის თქვენს საკუთარ სერვერზეა, ეს სერვერი."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "აქ Postulo-ს შეუძლია თქვენთან დაკავშირება"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Postulo-ს შეტყობინებების გაგზავნა Apprise-ის მეშვეობით Telegram-ზე, ntfy-ზე, Discord-ზე, Matrix-ზე, Gotify-ზე, Pushover-ზე, Signal-ზე, ელფოსტით და ასზე მეტ სხვა სერვისზე. თითოეული ერთი მისამართით აღინიშნება, რომელიც მის ავტორიზაციის მონაცემს შეიცავს და დაშიფრულად ინახება."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr "ამ ინსტანციაზე გამორთულია: %(services)s. ადმინისტრატორს შეუძლია ჩართოს."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "სერვისებმა %(seconds)d წამში არ უპასუხეს."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "მესამე მხარის შეტყობინებები Apprise-ის მეშვეობით"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "ეს არის სატესტო შეტყობინება თქვენი Apprise-ის კავშირიდან. შეხსენებები და აღებები იმავე გზით მოვა."
