#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s sur %(host)s : %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Une connexion contient au plus %(count)d URL Apprise."
msgstr[1] "Une connexion contient au plus %(count)d URL Apprise."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "URL Apprise"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Il faut au moins une URL Apprise."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Au moins un service a refusé le message."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Remis à %(count)d service."
msgstr[1] "Remis à %(count)d services."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "La ligne %(line)d (%(scheme)s) agit sur la machine où tourne Postulo, et non sur l'un de vos services : elle ne peut donc pas être utilisée ici."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "La ligne %(line)d demande de suivre les redirections; Postulo n'en suit jamais aucune : indiquez donc l'adresse finale."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "La ligne %(line)d n'est pas une URL Apprise que cette version comprend (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "La ligne %(line)d désigne un fichier sur la machine où tourne Postulo (%(argument)s=). Indiquez plutôt une adresse https."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Une par ligne, sous la forme d'Apprise : tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, et toutes les autres qu'Apprise répertorie. Les identifiants se trouvent dans l'URL : tout le champ est donc conservé chiffré et n'est plus jamais réaffiché; la liste des connexions n'indique que le nom de chaque service et, pour un service sur votre propre serveur, ce serveur."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo peut vous joindre ici"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Envoie les notifications de Postulo par Apprise vers Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, le courriel et plus d'une centaine d'autres services. Chacun est désigné par une adresse, qui contient ses identifiants et est conservée chiffrée."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Les services n'ont pas répondu dans les %(seconds)d secondes."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Notifications vers des services tiers par Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Ceci est le message de test de votre connexion Apprise. Les rappels et les captures arriveront de la même façon."
