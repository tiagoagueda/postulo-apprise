#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s á %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "Tenging getur geymt í mesta lagi %(count)d Apprise-slóð."
msgstr[1] "Tenging getur geymt í mesta lagi %(count)d Apprise-slóðir."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Acts on the machine Postulo runs on, not on a service of yours, so it cannot be used."
msgstr "Verkar á vélinni sem Postulo keyrir á, ekki á þjónustu frá þér, og því er ekki hægt að nota það."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise-slóðir"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Að minnsta kosti ein Apprise-slóð er nauðsynleg."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Að minnsta kosti ein þjónusta hafnaði skilaboðunum."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Sent til %(count)d þjónustu."
msgstr[1] "Sent til %(count)d þjónusta."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Lína %(line)d (%(scheme)s) virkar á vélinni sem Postulo keyrir á, ekki á þjónustu sem þú átt, svo ekki er hægt að nota hana hér."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Lína %(line)d biður um að áframsendingum sé fylgt; Postulo fylgir þeim aldrei, svo gefðu upp endanlega vistfangið."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Lína %(line)d er ekki Apprise-slóð sem þessi útgáfa skilur (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Lína %(line)d vísar á skrá á vélinni sem Postulo keyrir á (%(argument)s=). Gefðu upp https-vistfang í staðinn."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Needs {packages}, which is not installed on this machine."
msgstr "Þarfnast {packages}, sem er ekki uppsett á þessari vél."

#: src/postulo_apprise/services.py
#, fuzzy
msgid "Not available on this machine."
msgstr "Ekki í boði á þessari vél."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Ein á hverja línu, á formi Apprise: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, og hverjar þær aðrar sem Apprise telur upp. Innskráningarupplýsingarnar eru inni í slóðinni, svo allur reiturinn er geymdur dulkóðaður og aldrei sýndur aftur; tengingalistinn sýnir aðeins heiti hverrar þjónustu og, fyrir þjónustu á þínum eigin netþjóni, þann netþjón."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo getur náð í þig hér"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Sendu tilkynningar Postulo í gegnum Apprise til Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, í tölvupósti og til vel yfir hundrað annarra þjónusta. Hver þeirra er tilgreind með einu vistfangi sem geymir auðkenni hennar og er vistað dulkóðað."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Switched off on this instance: %(services)s. An administrator can switch it on."
msgstr "Slökkt á þessu tilviki: %(services)s. Stjórnandi getur kveikt á því."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Þjónusturnar svöruðu ekki innan %(seconds)d sekúndna."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Tilkynningar þriðja aðila í gegnum Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Þetta eru prufuskilaboðin frá Apprise-tengingunni þinni. Áminningar og grip berast á sama hátt."
