#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s på %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "En tilkobling holder på det meste %(count)d Apprise URL."
msgstr[1] "En tilkobling holder på det meste %(count)d Apprise URLs."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Apprise URLs"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "I det minste én Apprise URL er nødvendig."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "I hvert fall én tjeneste nektet budskapet."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Levert til %(count)d tjeneste."
msgstr[1] "Levert til %(count)d tjenester."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Line %(line)d (%(scheme)s) fungerer på maskinen Postulo kjører på, ikke på en tjeneste av din, så det kan ikke brukes her."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Linje %(line)d ber om at omdirigeringer skal følges; Postulo følger aldri en, så gi den endelige adressen."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Line %(line)d er ikke en Apprise URL denne versjonen forstår (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Linje %(line)d navngir en fil på maskinen Postulo kjører på (%(argument)s=). Gi en https-adresse i stedet."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "En per linje, i Apprises skjema: tgram://bot-token/chat-id, ntfy://topic, diskord://webhook-id/webhook-token, mailto://user:password@example.org, og noen av de andre Apprise-listene. Identifikasjonene bor inne i URL-adressen, så hele feltet lagres kryptert og vises aldri igjen; tilkoblingslisten viser bare navnet på hver tjeneste og for en egen server."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo kan nå deg her"

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Tjenestene svarte ikke innen %(seconds)d sekunder."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Dette er prøvemeldingen fra din Apprise-tilkobling. Påminnelser og opptak vil komme på samme måte."
