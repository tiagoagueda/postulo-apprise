#: src/postulo_apprise/notifier.py
#, python-format
msgid "%(service)s at %(host)s: %(error)s"
msgstr "%(service)s på %(host)s: %(error)s"

#: src/postulo_apprise/notifier.py
#, python-format
msgid "A connection holds at most %(count)d Apprise URL."
msgid_plural "A connection holds at most %(count)d Apprise URLs."
msgstr[0] "En tilkobling kan ha høyst %(count)d Apprise-URL."
msgstr[1] "En tilkobling kan ha høyst %(count)d Apprise-URL-er."

#: src/postulo_apprise/notifier.py
msgid "Apprise URLs"
msgstr "Apprise-URL-er"

#: src/postulo_apprise/notifier.py
msgid "At least one Apprise URL is needed."
msgstr "Minst én Apprise-URL er nødvendig."

#: src/postulo_apprise/notifier.py
msgid "At least one service refused the message."
msgstr "Minst én tjeneste avviste meldingen."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Delivered to %(count)d service."
msgid_plural "Delivered to %(count)d services."
msgstr[0] "Levert til %(count)d tjeneste."
msgstr[1] "Levert til %(count)d tjenester."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d (%(scheme)s) acts on the machine Postulo runs on, not on a service of yours, so it cannot be used here."
msgstr "Linje %(line)d (%(scheme)s) virker på maskinen Postulo kjører på, ikke på en av tjenestene dine, så den kan ikke brukes her."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d asks for redirects to be followed; Postulo never follows one, so give the final address."
msgstr "Linje %(line)d ber om at omdirigeringer skal følges; Postulo følger aldri omdirigeringer, så oppgi den endelige adressen."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Linje %(line)d er ikke en Apprise-URL som denne versjonen forstår (%(scheme)s)."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "Line %(line)d names a file on the machine Postulo runs on (%(argument)s=). Give an https address instead."
msgstr "Linje %(line)d peker på en fil på maskinen Postulo kjører på (%(argument)s=). Oppgi en https-adresse i stedet."

#: src/postulo_apprise/notifier.py
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list shows only the name of each service and, for one on a server of your own, that server."
msgstr "Én per linje, i Apprises format: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org og alle de andre som Apprise lister opp. Påloggingsopplysningene ligger i URL-en, så hele feltet lagres kryptert og vises aldri igjen; tilkoblingslisten viser bare navnet på hver tjeneste og, for en tjeneste på din egen server, den serveren."

#: src/postulo_apprise/notifier.py
msgid "Postulo can reach you here"
msgstr "Postulo kan nå deg her"

#: src/postulo_apprise/notifier.py
msgid "Send Postulo's notifications through Apprise to Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, email and well over a hundred other services. Each is named by one address, which holds its credential and is stored encrypted."
msgstr "Send Postulos varsler gjennom Apprise til Telegram, ntfy, Discord, Matrix, Gotify, Pushover, Signal, e-post og godt over hundre andre tjenester. Hver angis med én adresse, som inneholder påloggingsopplysningene og lagres kryptert."

#: src/postulo_apprise/notifier.py
#, python-format
msgid "The services did not answer within %(seconds)d seconds."
msgstr "Tjenestene svarte ikke innen %(seconds)d sekunder."

#: src/postulo_apprise/notifier.py
msgid "Third-party notifications via Apprise"
msgstr "Tredjepartsvarsler via Apprise"

#: src/postulo_apprise/notifier.py
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Dette er testmeldingen fra Apprise-tilkoblingen din. Påminnelser og fangster kommer fram på samme måte."
