msgid "Apprise"
msgstr "Apprise"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Apprise URLs"
msgstr "Apprise URLs"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one Apprise URL is needed."
msgstr "En azından bir Apprise URL gereklidir."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "At least one service refused the message."
msgstr "En azından bir hizmet mesajı reddetti."

#: src/postulo_apprise/notifier.py
#, fuzzy, python-format
msgid "Line %(line)d is not an Apprise URL this version understands (%(scheme)s)."
msgstr "Line %(line)d bu versiyonda bir Apprise URL değil ([X62X))."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "One per line, in Apprise's form: tgram://bot-token/chat-id, ntfy://topic, discord://webhook-id/webhook-token, mailto://user:password@example.org, and any of the others Apprise lists. The credentials live inside the URL, so the whole field is stored encrypted and never shown again; the connections list names each service with the secret parts masked."
msgstr "Bir per line, Apprise's form: tgram https://bot-token/chat-id, ntfy http://topik, diskord http://webhook-id/webhook-token, mailto https://user:password@system.org ve diğerlerinin herhangi biri Apprise listeleri. URL'de yaşayan kimlikler, bu yüzden tüm alan şifreli olarak depolanır ve asla tekrar gösterilmez; bağlantıları liste isimleri her servis gizli parçalar maskelenir."

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "Postulo can reach you here"
msgstr "Postulo size burada ulaşabilir"

#: src/postulo_apprise/notifier.py
#, fuzzy
msgid "This is the test message from your Apprise connection. Reminders and captures will arrive the same way."
msgstr "Bu, Apprise bağlantınızdan test mesajıdır. Hatırlatmalar ve yakalamalar aynı şekilde gelecek."
